<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_document" inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[@id='informations']" position="after">
            <div class="row mt32 mb32" id="informations2">
                <div name="expiration_date" t-if="doc.purpose" class="col-3 mb-2">
                    <strong>Purpose</strong>
                    <p t-field="doc.purpose"/>
                </div>
                <div name="payment_term" t-if="doc.payment_term_id"  class="col-3 mb-2">
                    <strong>Payment Terms</strong>
                    <p t-field="doc.payment_term_id"/>
                </div>
                <div name="commitment_date" t-if="doc.commitment_date"  class="col-3 mb-2">
                    <strong>Estimated Delivery</strong>
                    <p
                        t-field="doc.commitment_date"
                        t-options="{'widget': 'date', 'format': 'yyyy-MM-dd'}"
                    />
                </div>
                <div name="currency" t-if="doc.pricelist_id.currency_id"  class="col-3 mb-2">
                    <strong>Currency</strong>
                    <p t-field="doc.pricelist_id.currency_id"/>
                </div>
            </div>
        </xpath>
        <xpath expr="//th[@name='th_taxes']" position="attributes">
            <attribute name="hidden">1</attribute>
        </xpath>
        <xpath expr="//td[@name='td_taxes']" position="attributes">
            <attribute name="hidden">1</attribute>
        </xpath>
    </template>
</odoo>
