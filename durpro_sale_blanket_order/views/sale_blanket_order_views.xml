<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="sale_blanket_order_view_form" model="ir.ui.view">
        <field name="inherit_id" ref="sale_blanket_order.view_blanket_order_form"/>
        <field name="model">sale.blanket.order</field>
        <field name="name">sale.blanket.order.view.form</field>
        <field name="arch" type="xml">
            <group name="invoicing" position="before">
                <group name="delivery" string="Delivery">
                    <field name="incoterms_id"/>
                    <field name="warehouse_id"/>
                </group>
            </group>
            <field name="validity_date" position="after">
                <field name="purpose"/>
                <field name="tag_ids" widget="many2many_tags"/>
            </field>
        </field>
    </record>
    <record id="sale_blanket_order_view_tree" model="ir.ui.view">
        <field name="inherit_id" ref="sale_blanket_order.view_blanket_order_tree"/>
        <field name="model">sale.blanket.order</field>
        <field name="name">sale.blanket.order.view.tree</field>
        <field name="arch" type="xml">
            <field name="validity_date" position="after">
                <field name="tag_ids" widget="many2many_tags"/>
            </field>
        </field>
    </record>
</odoo>