<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="sale_order_view_form">
        <field name="name">sale.order.view.form</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <header position="inside">
                <button
                    name="action_create_blanket"
                    type="object"
                    class="btn btn-secondary"
                    string="Create Blanket"
                />

            </header>
            <div name="button_box" position="inside">
                <field name="blanket_order_count" invisible="1"/>
                <button
                        name="action_view_blanket_orders"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-calendar"
                        invisible="blanket_order_count == 0"
                >
                    <field
                            name="blanket_order_count"
                            widget="statinfo"
                            string="Blankets"
                    />
                </button>
            </div>
        </field>
    </record>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.from.blanket.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_blanket_order.view_order_form"/>
        <field name="arch" type="xml">
            <field name="blanket_order_line" position="attributes">
                <attribute name="column_invisible">False</attribute>
                <attribute name="optional">show</attribute>
            </field>
        </field>
    </record>
</odoo>